{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "0xui",
  "homepage": "https://github.com/Matsfjeldstad/0xui",
  "items": [
    {
      "name": "chain-selector",
      "type": "registry:component",
      "title": "Chain Selector",
      "description": "A chain selector component with network icons and seamless chain switching. Displays the current connected chain and allows users to switch between available chains.",
      "files": [
        {
          "path": "registry/default/chain-selector/chain-selector.tsx",
          "type": "registry:component"
        }
      ],
      "dependencies": ["wagmi", "viem", "@web3icons/react", "lucide-react"],
      "registryDependencies": ["button", "popover", "dialog", "tabs", "avatar"]
    },
    {
      "name": "wagmi-config",
      "type": "registry:file",
      "files": [
        {
          "path": "registry/default/config/config.ts",
          "type": "registry:file",
          "target": "config/config.ts"
        }
      ],
      "dependencies": ["wagmi", "viem", "@tanstack/react-query"]
    }
  ]
}

# Response headers for static files (Cloudflare Workers static assets).
#
# The Markdown twin of each page, the llms files and the JSON the shadcn CLI
# and agents read are for tools, not search results. Keep search engines on
# the HTML pages. This does not stop anything from fetching them.
/*.md
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
/r/*
  X-Robots-Tag: noindex
/props/*
  X-Robots-Tag: noindex

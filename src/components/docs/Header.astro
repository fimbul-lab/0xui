---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "./SiteTitle.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const nav = [
  { label: "Docs", href: "/getting-started/installation/", section: "/getting-started/" },
  { label: "Components", href: "/components/", section: "/components/" },
  { label: "Blocks", href: "/blocks/", section: "/blocks/" },
];
const github = "https://github.com/Matsfjeldstad/0xui";
// Pages without a sidebar (the landing page) have no menu button on small
// screens, so the section links and theme toggle stay in the header there.
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header" data-standalone={hasSidebar ? undefined : ""}>
  <div class="start">
    <SiteTitle />
    <nav class="links" aria-label="Sections">
      {
        nav.map(({ label, href, section }) => (
          <a href={href} aria-current={path.startsWith(section) ? "true" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="end print:hidden">
    <Search />
    <div class="actions">
      <a class="icon-link" href={github} rel="me" aria-label="0xui on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.78c-2.92.63-3.54-1.4-3.54-1.4-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.07-.64.07-.64 1.06.07 1.61 1.08 1.61 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.67-1.4-2.33-.27-4.78-1.17-4.78-5.19 0-1.15.41-2.08 1.08-2.82-.11-.26-.47-1.33.1-2.78 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.45.22 2.52.11 2.78.67.74 1.08 1.67 1.08 2.82 0 4.03-2.46 4.92-4.8 5.18.38.33.72.97.72 1.95v2.89c0 .28.19.6.72.5A10.5 10.5 0 0 0 12 1.5Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }
  .start,
  .end,
  .actions,
  .links {
    display: flex;
    align-items: center;
  }
  .start {
    gap: 1rem;
    min-width: 0;
  }
  .end {
    flex: 1;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .links {
    display: none;
    gap: 0.25rem;
  }
  .links a {
    border-radius: 0.375rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    transition: color 150ms var(--docs-ease);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--sl-color-white);
  }
  .actions {
    display: none;
    gap: 0.125rem;
  }
  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-3);
    transition:
      color 150ms var(--docs-ease),
      background-color 150ms var(--docs-ease);
  }
  .icon-link:hover {
    background-color: var(--docs-surface-2);
    color: var(--sl-color-white);
  }
  .icon-link svg {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: currentColor;
  }

  @media (pointer: coarse) {
    .links a {
      padding-block: 0.75rem;
    }
  }
  [data-standalone] :is(.links, .actions) {
    display: flex;
  }
  [data-standalone] .links a {
    padding-inline: 0.375rem;
  }
  [data-standalone] .icon-link {
    display: none;
  }

  /* Below this the sidebar menu holds navigation, GitHub and the theme. */
  @media (min-width: 50rem) {
    .start {
      gap: 2rem;
    }
    .links,
    .actions {
      display: flex;
    }
    [data-standalone] .links a {
      padding-inline: 0.625rem;
    }
    [data-standalone] .icon-link {
      display: inline-grid;
    }
  }
</style>

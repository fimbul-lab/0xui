---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no" aria-label="0xui home">
  <span class="prefix">0x</span>ui
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--__sl-font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--sl-color-white);
  }
  .prefix {
    color: var(--sl-color-gray-3);
    transition: color 150ms var(--docs-ease);
  }
  .site-title:hover .prefix {
    color: var(--docs-accent);
  }
</style>

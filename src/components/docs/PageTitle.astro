---
import registry from "../../../registry.json";
import { markdownPath } from "@/lib/agent-docs";

const { entry, id } = Astro.locals.starlightRoute;
const { title, description } = entry.data;

const sections: Record<string, string> = {
  "getting-started": "Getting started",
  components: "Components",
  blocks: "Blocks",
};
const [section, name] = id.split("/");
const eyebrow = section && name ? sections[section] : undefined;

// Component and block pages link to what `shadcn add` actually installs.
const item =
  section === "components" || section === "blocks"
    ? registry.items.find((entry) => entry.name === name)
    : undefined;
const source = item?.files[0]?.path;
const markdown = markdownPath(id);
---

<header class="page-title">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 id="_top">{title}</h1>
  {description && <p class="lead">{description}</p>}
  {
    (item || markdown) && (
      <ul class="meta" data-pagefind-ignore>
        {markdown && (
          <li>
            <button type="button" class="copy-page" data-markdown={markdown}>
              <span data-label>Copy page</span>
              <span class="sr-only" aria-live="polite" data-status></span>
            </button>
          </li>
        )}
        {markdown && (
          <li>
            <a href={markdown} type="text/markdown">
              Markdown
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </a>
          </li>
        )}
        {source && (
          <li>
            <a href={`https://github.com/fimbul-lab/0xui/blob/main/${source}`}>
              Source
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </a>
          </li>
        )}
        {item && (
          <li>
            <a href={`/r/${item.name}.json`}>
              Registry JSON
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </a>
          </li>
        )}
      </ul>
    )
  }
</header>

<script>
  // The fetch goes inside the ClipboardItem so Safari still counts the click
  // as the user gesture that allows the write.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-markdown]")) {
    const label = button.querySelector("[data-label]")!;
    const status = button.querySelector("[data-status]")!;
    let reset: ReturnType<typeof setTimeout>;
    button.addEventListener("click", async () => {
      const text = fetch(button.dataset.markdown!).then((response) => response.text());
      try {
        if (typeof ClipboardItem === "function") {
          await navigator.clipboard.write([
            new ClipboardItem({
              "text/plain": text.then((value) => new Blob([value], { type: "text/plain" })),
            }),
          ]);
        } else {
          await navigator.clipboard.writeText(await text);
        }
        label.textContent = "Copied";
        status.textContent = "Page copied as Markdown";
      } catch {
        label.textContent = "Couldn't copy";
        status.textContent = "Couldn't copy the page";
      }
      clearTimeout(reset);
      reset = setTimeout(() => {
        label.textContent = "Copy page";
        status.textContent = "";
      }, 2000);
    });
  }
</script>

<style>
  .page-title {
    padding-top: 0.5rem;
  }
  .eyebrow {
    margin-bottom: 0.75rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  h1 {
    font-size: var(--sl-text-h1);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }
  .lead {
    max-width: 38rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--sl-color-gray-3);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .meta a,
  .meta button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 1.75rem;
    border: 1px solid var(--docs-line);
    border-radius: 0.4375rem;
    padding: 0 0.5rem 0 0.625rem;
    background-color: var(--docs-surface);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    transition:
      border-color 150ms var(--docs-ease),
      color 150ms var(--docs-ease);
  }
  .meta button {
    padding-inline: 0.625rem;
    cursor: pointer;
  }
  .meta a:hover,
  .meta button:hover {
    border-color: var(--docs-line-strong);
    color: var(--sl-color-white);
  }
  .meta svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--sl-color-gray-4);
  }
  @media (pointer: coarse) {
    .meta a,
    .meta button {
      min-height: 2.75rem;
      padding-inline: 0.875rem 0.75rem;
    }
  }
</style>

---
/**
 * Starlight's footer (edit link, pagination) with a "Built by Fimbul Labs"
 * credit under it, on every page including the home page.
 *
 * Hovering or focusing the credit opens a card with Fimbul's preview image.
 * Pure CSS, so no script ships for it. The card only repeats what the link
 * leads to, and touch screens skip it: a tap just follows the link.
 */
import Default from "@astrojs/starlight/components/Footer.astro";

const href = "https://fimbul.io";
---

<Default />

<div class="credit not-content">
  <a class="link" href={href} rel="noopener">
    <svg viewBox="0 0 112 221" aria-hidden="true">
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M0 155.339V194.151V221H30.6155V167.157L110.456 96.7625L91.4225 74.7315L30.6155 128.345V97.7638L112 27.2586L93.1573 5.06107L30.6155 59.2424V0H0V85.7653V124.287V155.339Z"
      ></path>
    </svg>
    <span>Built by <strong>Fimbul Labs</strong></span>
  </a>

  <a class="card" href={href} rel="noopener" tabindex="-1" aria-hidden="true">
    <img
      src="/fimbul-og.png"
      alt=""
      width="1200"
      height="630"
      loading="lazy"
      decoding="async"
    />
    <span class="body">
      <span class="title">Fimbul Labs</span>
      <span class="text">
        A web3 agency and developer group, building web3 experiences for humans and agents
        alike. 0xui is our first project.
      </span>
      <span class="url">fimbul.io ↗</span>
    </span>
  </a>
</div>

<style>
  .credit {
    position: relative;
    width: fit-content;
    margin-top: 3rem;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    transition: color 150ms var(--docs-ease);
  }
  .link svg {
    flex-shrink: 0;
    width: auto;
    height: 1.125rem;
    color: var(--sl-color-gray-2);
    transition: color 150ms var(--docs-ease);
  }
  .link strong {
    font-weight: 500;
    color: var(--sl-color-gray-2);
    transition: color 150ms var(--docs-ease);
  }
  .credit:hover .link,
  .link:focus-visible,
  .credit:hover .link :is(svg, strong),
  .link:focus-visible :is(svg, strong) {
    color: var(--sl-color-white);
  }

  /* The card opens above the credit, after a short delay so passing over
     the link does not flash it, and closes a little slower than it opens. */
  .card {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    z-index: 10;
    display: none;
    width: min(20rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid var(--docs-line-strong);
    border-radius: 0.75rem;
    background-color: var(--docs-surface);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 8%),
      0 12px 32px -8px oklch(0 0 0 / 24%);
    text-decoration: none;
    color: inherit;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px) scale(0.98);
    transform-origin: bottom left;
    transition:
      opacity 150ms var(--docs-ease) 100ms,
      transform 150ms var(--docs-ease) 100ms,
      visibility 0s linear 250ms;
  }
  /* Bridges the gap to the link, so moving onto the card keeps it open. */
  .card::after {
    content: "";
    position: absolute;
    top: 100%;
    inset-inline: 0;
    height: 0.5rem;
  }
  @media (hover: hover) {
    .card {
      display: block;
    }
    .credit:hover .card,
    .credit:has(.link:focus-visible) .card {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 200ms var(--docs-ease) 300ms,
        transform 200ms var(--docs-ease) 300ms,
        visibility 0s linear 300ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .credit:hover .card,
    .credit:has(.link:focus-visible) .card {
      transform: none;
    }
  }

  .card img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--docs-line);
    background-color: oklch(0.16 0.01 270);
  }
  .body {
    display: grid;
    gap: 0.375rem;
    padding: 0.875rem 1rem 1rem;
  }
  .title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .text {
    font-size: 0.8125rem;
    line-height: 1.5;
    text-wrap: pretty;
    color: var(--sl-color-gray-3);
  }
  .url {
    margin-top: 0.25rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }
  .card:hover .url {
    color: var(--docs-accent);
  }
</style>

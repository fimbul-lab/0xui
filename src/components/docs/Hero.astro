---
import { getCollection } from "astro:content";
import pkg from "../../../package.json";
import { Default as Swap } from "@/demos/swap";
import CopyCommand from "./CopyCommand.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

const docs = await getCollection("docs");
const count = (section: string) =>
  docs.filter((doc) => doc.id.startsWith(`${section}/`)).length;
---

<section class="hero">
  <div class="copy">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      v{pkg.version}
      <span class="sep" aria-hidden="true">/</span>
      {count("components")} components
      <span class="sep" aria-hidden="true">/</span>
      {count("blocks")} blocks
    </p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="actions">
      {
        actions.map(({ link, text, variant }) => (
          <a class="button" data-variant={variant} href={link}>
            {text}
            {variant === "primary" && (
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            )}
          </a>
        ))
      }
    </div>
    <CopyCommand command="npx shadcn@latest add @0xui/wallet-button" />
  </div>

  <div class="stage not-content">
    <span class="tag">
      <a href="/blocks/swap/">blocks/swap</a>
      <span>live</span>
    </span>
    <Swap client:load />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: 2.5rem 1rem;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: var(--docs-accent);
  }
  .sep {
    color: var(--sl-color-gray-5);
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }
  .tagline {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--sl-color-gray-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 2rem 1rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.75rem;
    border: 1px solid var(--docs-line-strong);
    border-radius: 0.625rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--sl-color-white);
    transition:
      background-color 150ms var(--docs-ease),
      border-color 150ms var(--docs-ease),
      scale 150ms var(--docs-ease);
  }
  .button:hover {
    background-color: var(--docs-surface-2);
  }
  .button:active {
    scale: 0.98;
  }
  .button[data-variant="primary"] {
    border-color: var(--sl-color-white);
    padding-inline-end: 0.875rem;
    background-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .button[data-variant="primary"]:hover {
    border-color: var(--sl-color-gray-1);
    background-color: var(--sl-color-gray-1);
  }
  .button svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 150ms var(--docs-ease);
  }
  .button:hover svg {
    translate: 2px 0;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-width: 0;
    min-height: 30rem;
    border: 1px solid var(--docs-line);
    border-radius: 0.875rem;
    padding: 3rem 1rem 1.5rem;
  }
  .tag {
    position: absolute;
    inset: 0.75rem 0.875rem auto;
    display: flex;
    justify-content: space-between;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }
  .tag a {
    color: inherit;
    text-decoration: none;
  }
  .tag a:hover {
    color: var(--sl-color-white);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: 4rem;
      padding-block: 4rem 2rem;
    }
  }
</style>

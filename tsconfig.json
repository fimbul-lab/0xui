{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "paths": {
      // shadcn primitives and `cn` are docs-site code. The more specific
      // patterns win, so `shadcn add <primitive>` writes into src/.
      "@/components/ui/*": ["./src/components/ui/*"],
      "@/lib/utils": ["./src/lib/utils"],
      // Registry files first, then docs-only code. Mirrors scripts/registry-resolver.mjs.
      "@/*": ["./registry/default/*", "./src/*"]
    }
  }
}
